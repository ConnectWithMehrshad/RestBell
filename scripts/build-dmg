#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
arm_app="$(./scripts/build-app --triple arm64-apple-macosx14.0)"
intel_app="$(./scripts/build-app --triple x86_64-apple-macosx14.0)"

stage="$(mktemp -d "$PWD/.build/restbell-dmg.XXXXXX")"
trap 'rm -rf "$stage"' EXIT
contents="$stage/contents"
app="$contents/RestBell.app"
dmg="$PWD/.build/RestBell.dmg"

mkdir "$contents"
ditto "$arm_app" "$app"
lipo -create "$arm_app/Contents/MacOS/RestBell" "$intel_app/Contents/MacOS/RestBell" \
    -output "$stage/RestBell"
install -m 755 "$stage/RestBell" "$app/Contents/MacOS/RestBell"
codesign --force --sign - "$app" >&2
codesign --verify --strict --all-architectures "$app"
lipo "$app/Contents/MacOS/RestBell" -verify_arch arm64 x86_64
ln -s /Applications "$contents/Applications"

hdiutil create -volname RestBell -srcfolder "$contents" -format UDZO "$stage/RestBell.dmg" >&2
hdiutil verify "$stage/RestBell.dmg" >&2
mv "$stage/RestBell.dmg" "$dmg"
printf '%s\n' "$dmg"
