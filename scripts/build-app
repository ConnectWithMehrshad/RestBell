#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
swift build --configuration release "$@" >&2
build_dir="$(swift build --configuration release "$@" --show-bin-path)"
app="$build_dir/RestBell.app"

mkdir -p "$app/Contents/MacOS"
install -m 755 "$build_dir/RestBell" "$app/Contents/MacOS/RestBell"
install -m 644 Support/Info.plist "$app/Contents/Info.plist"
codesign --force --sign - "$app" >&2

printf '%s\n' "$app"
